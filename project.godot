; Engine configuration file.
config_version=5

[application]
config/name="Lumen"
config/description="Open this folder in Godot, then enable the Lumen plugin."
config/features=PackedStringArray("4.2", "Forward Plus")

[editor_plugins]
enabled=PackedStringArray("res://addons/lumen/plugin.cfg")

[rendering]
renderer/rendering_method="forward_plus"
